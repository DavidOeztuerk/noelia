<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 (missing XML comment) is suppressed: the summaries that matter are
      written, and requiring one on every member produces noise, not
      documentation. Everything else about the docs is an error, not a warning —
      a wrong cref or a half-documented signature reaches consumers as
      IntelliSense and misleads them there.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Every documentation diagnostic, not a list I remembered: CS1734 slipped
      through the first time because I enumerated instead of covering the range.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1592;CS1710;CS1711;CS1712;CS1723;CS1734</WarningsAsErrors>

    <!--
      The build is warning-free, so keep it that way: a warning nobody has to
      act on trains everyone to scroll past the one that matters.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>David Öztürk</Authors>
    <Company>David Öztürk</Company>
    <Product>Noelia</Product>
    <Copyright>Copyright © David Öztürk</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DavidOeztuerk/noelia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DavidOeztuerk/noelia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>noelia;microservices;cqrs;security;multi-tenancy;sovereignty</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <VersionPrefix>5.1.0</VersionPrefix>
    <PackageReleaseNotes>https://github.com/DavidOeztuerk/noelia/releases/tag/v$(VersionPrefix)</PackageReleaseNotes>

    <!-- Ties a package back to the exact commit it was built from. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Test projects are not packages. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
