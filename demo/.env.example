# Copy to .env before the first `docker compose up`.
#
# One key pair for the whole system. user-service gets the private half and
# is the only service that can issue a token; everyone else gets the public
# half and can only verify one.
#
# Generate a pair with Noelia:
#   SigningKey.GenerateKeyPair(kid: "2026-08").ToEnvironmentLines()
#
# or with openssl:
#   PRIV=$(openssl ecparam -name prime256v1 -genkey -noout -outform DER \
#     | openssl pkcs8 -topk8 -nocrypt -inform DER -outform DER | base64 | tr -d '\n')
#   PUB=$(echo "$PRIV" | base64 -d | openssl pkey -inform DER -pubout -outform DER | base64 | tr -d '\n')

NOELIA_JWT_KID=2026-08
NOELIA_JWT_PRIVATE_KEY=
NOELIA_JWT_PUBLIC_KEY=

# The operator dashboard in Staging and Production. Generate one per
# installation and keep it out of the repository:
#
#   openssl rand -base64 32
#
# Presented in the X-Noelia-Operator header. Anyone without it gets the same
# 404 as a caller who guessed the path — the dashboard never announces that it
# exists.
NOELIA_DASHBOARD_OPERATOR_SECRET=
