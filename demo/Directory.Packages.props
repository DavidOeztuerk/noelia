<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoeliaVersion>5.3.0</NoeliaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Noelia.Abstractions" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Application" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Contracts" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Core" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Data.EntityFrameworkCore" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Dashboard" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Http" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.InMemory" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Infrastructure" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Messaging.MassTransit" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Passwords.Argon2" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Passwords.BCrypt" Version="$(NoeliaVersion)" />
    <PackageVersion Include="Noelia.Redis" Version="$(NoeliaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Ocelot" Version="25.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
