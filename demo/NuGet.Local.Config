<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds the demo against a Noelia candidate that is not on nuget.org yet.
  The path is relative, so this is the same file on every machine and in CI —
  which is why it is committed rather than ignored: the demo job in ci.yml
  cannot build a candidate without it.
  See demo/README.md, "Building against a candidate", for the commands.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="candidate" value="./.local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="candidate">
      <package pattern="Noelia.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
